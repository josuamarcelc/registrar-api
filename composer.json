{
  "name": "josuamarcelc/registrar-api",
  "description": "Unified PHP Registrar API (NameSilo, GoDaddy, Namecheap, Dynadot, Cloudflare) with pluggable adapters.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "domain",
    "registrar",
    "api",
    "dns",
    "namesilo",
    "godaddy",
    "namecheap",
    "dynadot",
    "cloudflare"
  ],
  "homepage": "https://github.com/josuamarcelc/registrar-api",
  "support": {
    "issues": "https://github.com/josuamarcelc/registrar-api/issues",
    "source": "https://github.com/josuamarcelc/registrar-api"
  },
  "autoload": {
    "psr-4": {
      "RegistrarAPI\\": "src/",
      "RegistrarAPI\\Adapters\\": "src/adapters/"
    }
  },
  "authors": [
    {
      "name": "josuamarcelc",
      "email": "me@josuamarcelc.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "php tests/run.php"
  }
}
